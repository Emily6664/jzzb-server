/* pages/nfc-trace/nfc-trace.wxss —— NFC 溯源
 * 字号、按钮尺寸、圆角全部走 app.wxss 的 CSS 变量，
 * 切到长辈大字 / 儿童简易时本页整体跟随，无需另写一套样式。
 */
.page {
  padding: 32rpx 32rpx 120rpx;
}

/* ==================== 标题 ==================== */
.hero {
  margin-bottom: 28rpx;
}

.hero-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: #2b2b2b;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: var(--font-size-base);
  color: #7a7468;
}

.hero-mode {
  margin-top: 8rpx;
  font-size: var(--font-size-sm);
  color: #9a9488;
}

/* ==================== 触碰卡片 ==================== */
.touch-card {
  margin-bottom: 28rpx;
  padding: 28rpx 24rpx;
  background: #ffffff;
  border: 2rpx solid #e6e1d8;
  border-radius: var(--btn-radius);
}

.touch-card-off {
  background: #faf7f0;
  border-style: dashed;
}

.touch-status {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: #2b2b2b;
  line-height: 1.6;
}

.touch-reason {
  margin-top: 10rpx;
  font-size: var(--font-size-sm);
  line-height: 1.6;
  color: #9a9488;
}

/* ==================== 按钮 ==================== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: var(--btn-height);
  margin: 20rpx 0 0;
  padding: var(--btn-padding);
  box-sizing: border-box;
  font-size: var(--btn-font-size);
  line-height: 1.2;
  border-radius: var(--btn-radius);
  background: #ffffff;
  border: 2rpx solid #e6e1d8;
  color: #2b2b2b;
  overflow: hidden;
}

.btn::after {
  border: none;
}

.btn[disabled] {
  opacity: 0.72;
}

.btn-primary {
  background: #8b6f47;
  border-color: #8b6f47;
  color: #ffffff;
}

.btn-ghost {
  background: #f5f1e8;
}

.btn-outline {
  margin-top: 20rpx;
  background: #ffffff;
  border-color: #8b6f47;
  color: #8b6f47;
}

.btn-mini {
  width: auto;
  height: calc(var(--btn-height) * 0.8);
  margin: 0;
  padding: 0 28rpx;
  font-size: var(--font-size-sm);
  white-space: nowrap;
}

/* ==================== 演示 / 扫码 ==================== */
.block {
  margin-bottom: 28rpx;
}

.block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.block-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: #2b2b2b;
}

.block-hint {
  font-size: var(--font-size-sm);
  color: #9a9488;
}

.demo-row {
  display: flex;
  align-items: center;
}

.demo-input {
  flex: 1;
  min-width: 0;
  height: var(--btn-height);
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: var(--font-size-base);
  color: #2b2b2b;
  background: #ffffff;
  border: 2rpx solid #e6e1d8;
  border-radius: var(--btn-radius);
}

.demo-row .btn-mini {
  margin-left: 16rpx;
  height: var(--btn-height);
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.chip {
  margin: 0 12rpx 12rpx 0;
  padding: 10rpx 20rpx;
  font-size: var(--font-size-sm);
  color: #8b6f47;
  background: #fdfaf3;
  border: 2rpx solid #e6e1d8;
  border-radius: 999rpx;
}

/* ==================== 加载 ==================== */
.loading-row {
  padding: 32rpx 0;
  text-align: center;
}

.loading-text {
  font-size: var(--font-size-base);
  color: #8b6f47;
}

/* ==================== 结果 ==================== */
.result {
  padding: 28rpx 24rpx;
  background: #ffffff;
  border: 2rpx solid #e6e1d8;
  border-radius: var(--btn-radius);
}

.result-head {
  margin-bottom: 20rpx;
}

.result-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: #2b2b2b;
}

.result-meta {
  margin-top: 8rpx;
  font-size: var(--font-size-sm);
  color: #9a9488;
}

.audio-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: #fdfaf3;
  border: 2rpx solid #efe9db;
  border-radius: var(--btn-radius);
}

.audio-text {
  flex: 1;
  min-width: 0;
}

.audio-title {
  display: block;
  font-size: var(--font-size-base);
  font-weight: 600;
  color: #2b2b2b;
}

.audio-sub {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-size-sm);
  color: #7a7468;
}

.story {
  margin: 24rpx 0 8rpx;
  font-size: var(--font-size-base);
  line-height: 1.9;
  color: #3a3a3a;
  text-align: justify;
  word-break: break-all;
}

.section-title {
  margin: 28rpx 0 16rpx;
  font-size: var(--font-size-base);
  font-weight: 600;
  color: #2b2b2b;
}

.history-grid {
  display: flex;
  flex-wrap: wrap;
}

.history-cell {
  width: 32%;
  margin: 0 2% 16rpx 0;
}

.history-cell:nth-child(3n) {
  margin-right: 0;
}

.history-img {
  display: block;
  width: 100%;
  height: 190rpx;
  border-radius: 12rpx;
  background: #f2eee4;
}

.history-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #efe9db;
}

.history-fallback-text {
  font-size: var(--font-size-sm);
  color: #9a9488;
}

.link-row {
  display: flex;
  align-items: stretch;
  margin-top: 12rpx;
}

.link-row .btn {
  flex: 1;
}

.link-row .btn + .btn {
  margin-left: 16rpx;
}

/* ==================== 空态 / 错误 ==================== */
.empty {
  padding: 80rpx 24rpx;
  text-align: center;
}

.empty-text {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: #2b2b2b;
}

.empty-tip {
  margin-top: 14rpx;
  font-size: var(--font-size-sm);
  line-height: 1.7;
  color: #9a9488;
}

.error-text {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  font-size: var(--font-size-sm);
  line-height: 1.6;
  color: #b4472f;
  background: #fdf1ee;
  border-radius: var(--btn-radius);
}

/* ==================== 模式微调 ==================== */
.ui-mode-elder .story {
  line-height: 2.1;
}

.ui-mode-elder .history-img {
  height: 240rpx;
}

.ui-mode-child .touch-card,
.ui-mode-child .result,
.ui-mode-child .demo-input,
.ui-mode-child .btn {
  border-radius: 999rpx;
}

.ui-mode-child .story {
  border-radius: 24rpx;
}
