/* pages/setting/setting.wxss —— 设置页
 * 选项卡片的高度、字号、圆角全部走 CSS 变量，切换模式时本页即可看到变化。
 */
.page {
  padding: 40rpx 32rpx 96rpx;
}

.section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: #2b2b2b;
  margin-bottom: 24rpx;
}

.option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--btn-height);
  padding: 24rpx var(--btn-padding);
  margin-bottom: 20rpx;
  box-sizing: border-box;
  background: #ffffff;
  border: 2rpx solid transparent;
  border-radius: var(--btn-radius);
}

.option-active {
  border-color: #8b6f47;
  background: #fdfaf3;
}

.option-hover {
  background: #f5f1e8;
}

.option-main {
  flex: 1;
  min-width: 0;
}

.option-label {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: #2b2b2b;
}

.option-desc {
  margin-top: 8rpx;
  font-size: var(--font-size-sm);
  line-height: 1.6;
  color: #7a7468;
}

.option-check {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 6rpx 18rpx;
  font-size: var(--font-size-sm);
  color: #ffffff;
  background: #8b6f47;
  border-radius: 999rpx;
}

.foot-tip {
  margin-top: 32rpx;
  font-size: var(--font-size-sm);
  line-height: 1.7;
  color: #9a9488;
}

/* ==================== 模式微调 ==================== */
/* 长辈模式：选项行更宽松，选中标记更醒目 */
.ui-mode-elder .option {
  padding: 28rpx var(--btn-padding);
}

.ui-mode-elder .option-check {
  padding: 8rpx 22rpx;
}

/* 儿童模式：选项卡片大圆角 */
.ui-mode-child .option {
  border-radius: 44rpx;
}

