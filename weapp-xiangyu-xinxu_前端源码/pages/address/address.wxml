<!-- pages/address/address.wxml —— 收货地址管理 -->
<view class="page {{uiModeClass}}">

  <view class="head">
    <view class="head-title">收货地址</view>
    <view class="head-sub">共 {{list.length}} 条 · 只保存在本机</view>
  </view>

  <view class="empty" wx:if="{{list.length === 0}}">
    <view class="empty-text">还没有收货地址</view>
    <view class="empty-tip">下单前需要先添加一个收货地址</view>
  </view>

  <view class="list" wx:else>
    <view class="card" wx:for="{{list}}" wx:key="addressId">
      <view class="card-top">
        <text class="card-name">{{item.name}}</text>
        <text class="card-phone">{{item.phone}}</text>
        <text class="card-badge" wx:if="{{item.isDefault}}">默认</text>
      </view>

      <view class="card-addr">{{item.regionText}} {{item.detail}}</view>

      <view class="card-ops">
        <text class="op" wx:if="{{!item.isDefault}}" data-id="{{item.addressId}}" bindtap="onSetDefault">设为默认</text>
        <text class="op" data-id="{{item.addressId}}" bindtap="onEdit">编辑</text>
        <text class="op op-danger" data-id="{{item.addressId}}" bindtap="onDelete">删除</text>
      </view>
    </view>
  </view>

  <view class="foot-actions">
    <button class="btn btn-primary" bindtap="onAdd">新增收货地址</button>
    <button class="btn btn-ghost" bindtap="onWechatAddress">使用微信收货地址</button>
  </view>

  <!-- ============ 表单弹层 ============ -->
  <view class="mask" wx:if="{{showForm}}" bindtap="onCancelForm" catchtouchmove="noop">
    <view class="sheet" catchtap="stopBubble">
      <view class="sheet-head">
        <text class="sheet-title">{{form.addressId ? '编辑地址' : '新增地址'}}</text>
        <text class="sheet-close" bindtap="onCancelForm">关闭</text>
      </view>

      <view class="field">
        <text class="field-label">收货人</text>
        <input class="field-input" value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="请填写姓名" />
      </view>

      <view class="field">
        <text class="field-label">手机号</text>
        <input
          class="field-input"
          type="number"
          maxlength="11"
          value="{{form.phone}}"
          data-field="phone"
          bindinput="onInput"
          placeholder="请填写 11 位手机号"
        />
      </view>

      <view class="field">
        <text class="field-label">地区</text>
        <picker mode="region" value="{{form.region}}" bindchange="onRegionChange">
          <view class="field-input picker-value">{{regionText || '请选择省 / 市 / 区'}}</view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">详细地址</text>
        <input class="field-input" value="{{form.detail}}" data-field="detail" bindinput="onInput" placeholder="街道、门牌号" />
      </view>

      <view class="field field-row">
        <text class="field-label">设为默认</text>
        <switch checked="{{form.isDefault}}" bindchange="onDefaultChange" color="#8b6f47" />
      </view>

      <button class="btn btn-primary sheet-btn" loading="{{submitting}}" bindtap="onSave">保存</button>
    </view>
  </view>
</view>
