/* pages/address/address.wxss —— 收货地址管理
 * 字号、按钮尺寸、圆角全部走 app.wxss 的 CSS 变量，切模式时本页自动跟随。
 */
.page {
  padding: 32rpx 32rpx 200rpx;
}

/* ==================== 页头 ==================== */
.head {
  margin-bottom: 24rpx;
}

.head-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: #2b2b2b;
}

.head-sub {
  margin-top: 8rpx;
  font-size: var(--font-size-sm);
  color: #9a9488;
}

/* ==================== 地址卡片 ==================== */
.card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 2rpx solid #e6e1d8;
  border-radius: var(--btn-radius);
}

.card-top {
  display: flex;
  align-items: center;
}

.card-name {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: #2b2b2b;
}

.card-phone {
  margin-left: 16rpx;
  font-size: var(--font-size-sm);
  color: #7a7468;
}

.card-badge {
  margin-left: 16rpx;
  padding: 2rpx 14rpx;
  font-size: var(--font-size-sm);
  color: #ffffff;
  background: #8b6f47;
  border-radius: 999rpx;
}

.card-addr {
  margin-top: 14rpx;
  font-size: var(--font-size-sm);
  line-height: 1.7;
  color: #544b3d;
}

.card-ops {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #efe9db;
}

.op {
  margin-left: 28rpx;
  font-size: var(--font-size-sm);
  color: #8b6f47;
}

.op-danger {
  color: #d9534f;
}

/* ==================== 底部操作 ==================== */
.foot-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fffdf7;
  border-top: 2rpx solid #e6e1d8;
}

/* ==================== 按钮 ==================== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: var(--btn-height);
  margin-top: 16rpx;
  padding: var(--btn-padding);
  box-sizing: border-box;
  font-size: var(--btn-font-size);
  border-radius: var(--btn-radius);
  background: #ffffff;
  border: 2rpx solid #e6e1d8;
  color: #2b2b2b;
  overflow: hidden;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #8b6f47;
  border-color: #8b6f47;
  color: #ffffff;
}

.btn-ghost {
  background: #f5f1e8;
}

/* ==================== 表单弹层 ==================== */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(40, 32, 20, 0.42);
}

.sheet {
  width: 100%;
  max-height: 88vh;
  padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #fffdf7;
  border-radius: 28rpx 28rpx 0 0;
  overflow-y: auto;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.sheet-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: #2b2b2b;
}

.sheet-close {
  padding: 8rpx 20rpx;
  font-size: var(--font-size-sm);
  color: #7a7468;
  background: #f2eee4;
  border-radius: 999rpx;
}

.field {
  display: flex;
  align-items: center;
  min-height: var(--btn-height);
  border-bottom: 2rpx solid #f2eee4;
}

.field-label {
  flex-shrink: 0;
  width: 150rpx;
  font-size: var(--font-size-sm);
  color: #7a7468;
}

.field-input {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-base);
  color: #2b2b2b;
}

.picker-value {
  padding: 24rpx 0;
  line-height: 1.5;
}

.field-row {
  justify-content: space-between;
}

.sheet-btn {
  margin-top: 32rpx;
}

/* ==================== 空态 ==================== */
.empty {
  padding: 100rpx 24rpx;
  text-align: center;
}

.empty-text {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: #2b2b2b;
}

.empty-tip {
  margin-top: 14rpx;
  font-size: var(--font-size-sm);
  color: #9a9488;
}

/* ==================== 模式微调 ==================== */
.ui-mode-child .card,
.ui-mode-child .sheet,
.ui-mode-child .btn {
  border-radius: 44rpx;
}
