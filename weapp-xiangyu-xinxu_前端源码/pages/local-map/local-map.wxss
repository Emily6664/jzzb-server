/* pages/local-map/local-map.wxss —— 围山手绘动态地图
 * 字号、按钮尺寸、圆角全部走 app.wxss 的 CSS 变量，
 * 弹窗与标记会随长辈大字 / 儿童简易模式自动切换。
 */
.page {
  padding: 32rpx 32rpx 80rpx;
}

/* ==================== 标题 ==================== */
.map-head {
  margin-bottom: 24rpx;
}

.map-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: #2b2b2b;
}

.map-sub {
  margin-top: 8rpx;
  font-size: var(--font-size-base);
  color: #7a7468;
}

.map-mode {
  margin-top: 8rpx;
  font-size: var(--font-size-sm);
  color: #9a9488;
}

/* ==================== 地图舞台 ==================== */
.stage-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.map-stage {
  position: relative;
  overflow: hidden;
  background: #f6efe0;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(139, 111, 71, 0.16);
}

.map-img {
  display: block;
  width: 100%;
  height: 100%;
}

.map-fallback {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.map-fallback-text {
  font-size: var(--font-size-base);
  color: #a89d86;
}

/* ==================== 小狗标记 ==================== */
/* 零尺寸锚点：子元素相对它定位，保证「狗的脚」正好落在坐标点上 */
.spot {
  position: absolute;
  width: 0;
  height: 0;
}

.spot-body {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 88rpx;
  height: 88rpx;
  margin-left: -44rpx;
}

/* 脚下的一小片投影 */
.spot-body::after {
  content: '';
  position: absolute;
  left: 18rpx;
  bottom: -2rpx;
  width: 52rpx;
  height: 12rpx;
  background: rgba(88, 70, 44, 0.18);
  border-radius: 50%;
}

.spot-dog {
  position: relative;
  display: block;
  width: 88rpx;
  height: 88rpx;
}

.spot-name {
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 2rpx 12rpx;
  font-size: var(--font-size-sm);
  line-height: 1.5;
  color: #ffffff;
  white-space: nowrap;
  background: rgba(139, 111, 71, 0.86);
  border-radius: 999rpx;
}

.stage-tip {
  margin-top: 16rpx;
  font-size: var(--font-size-sm);
  line-height: 1.6;
  color: #9a9488;
  text-align: center;
}

/* ==================== 弹窗 ==================== */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(40, 32, 20, 0.42);
}

.sheet {
  width: 100%;
  max-height: 86vh;
  padding: 28rpx 32rpx 48rpx;
  box-sizing: border-box;
  background: #fffdf7;
  border-radius: 28rpx 28rpx 0 0;
  overflow-y: auto;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sheet-title {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: #2b2b2b;
}

.sheet-close {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 20rpx;
  font-size: var(--font-size-sm);
  color: #7a7468;
  background: #f2eee4;
  border-radius: 999rpx;
}

.sheet-img {
  display: block;
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  background: #f2eee4;
}

.sheet-img-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #efe9db;
}

.sheet-img-text {
  font-size: var(--font-size-base);
  color: #9a9488;
}

.sheet-desc {
  margin-top: 24rpx;
  font-size: var(--font-size-base);
  line-height: 1.8;
  color: #3a3a3a;
}

.sheet-meta {
  margin-top: 12rpx;
  font-size: var(--font-size-sm);
  color: #9a9488;
}

.sheet-actions {
  display: flex;
  align-items: stretch;
  margin-top: 32rpx;
}

.sheet-actions .btn {
  flex: 1;
}

.sheet-actions .btn + .btn {
  margin-left: 16rpx;
}

/* ==================== 按钮 ==================== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--btn-height);
  padding: var(--btn-padding);
  box-sizing: border-box;
  font-size: var(--btn-font-size);
  line-height: 1.2;
  border-radius: var(--btn-radius);
  background: #ffffff;
  border: 2rpx solid #e6e1d8;
  color: #2b2b2b;
  overflow: hidden;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #8b6f47;
  border-color: #8b6f47;
  color: #ffffff;
}

.btn-ghost {
  background: #f5f1e8;
}

.error-text {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  font-size: var(--font-size-sm);
  line-height: 1.6;
  color: #b4472f;
  background: #fdf1ee;
  border-radius: var(--btn-radius);
}

/* ==================== 模式微调 ==================== */
.ui-mode-elder .spot-body,
.ui-mode-elder .spot-dog {
  width: 112rpx;
  height: 112rpx;
}

.ui-mode-elder .spot-body {
  margin-left: -56rpx;
}

.ui-mode-elder .spot-body::after {
  left: 22rpx;
  width: 68rpx;
}

.ui-mode-elder .sheet-img {
  height: 380rpx;
}

.ui-mode-child .map-stage,
.ui-mode-child .sheet,
.ui-mode-child .sheet-img,
.ui-mode-child .btn {
  border-radius: 40rpx;
}

.ui-mode-child .spot-name {
  background: rgba(139, 111, 71, 0.92);
  font-weight: 600;
}

/* ==================== 定位：你在这里 ==================== */
.locate-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 14rpx;
  padding: 0 10rpx;
}

/* 「模拟」标记：不骗人，演示位置必须标出来 */
.locate-tag {
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #f7f3e8;
  background: var(--zhu, #b3382c);
}

.locate-text {
  font-size: var(--f-small, 23rpx);
  line-height: 1.6;
  color: var(--mute, #6b6252);
  text-align: center;
}

.locate-act {
  font-size: var(--f-small, 23rpx);
  color: var(--zhu, #b3382c);
  border-bottom: 2rpx solid var(--zhu, #b3382c);
  padding-bottom: 2rpx;
}

/* 精确落点：一个朱红点 + 一圈会呼吸的环 */
.me {
  position: absolute;
  width: 0;
  height: 0;
}

.me-dot {
  position: absolute;
  left: -9rpx;
  top: -9rpx;
  box-sizing: content-box;
  width: 18rpx;
  height: 18rpx;
  background: var(--zhu, #b3382c);
  border: 3rpx solid #f2efe4;
  border-radius: 50%;
}

.me-ring {
  position: absolute;
  left: -40rpx;
  top: -40rpx;
  width: 80rpx;
  height: 80rpx;
  border: 2rpx solid var(--zhu, #b3382c);
  border-radius: 50%;
  animation: me-pulse 2.4s ease-out infinite;
}

/* 最近点位指示圈：虚线，比落点弱一档 */
.near-ring {
  position: absolute;
  left: -62rpx;
  top: -106rpx; /* 锚点在狗脚，往上抬 44rpx 让小圈套住狗身 */
  width: 124rpx;
  height: 124rpx;
  border: 2rpx dashed var(--zhu, #b3382c);
  border-radius: 50%;
  animation: near-pulse 3s ease-out infinite;
}

@keyframes me-pulse {
  0% { transform: scale(0.45); opacity: 0.6; }
  70% { transform: scale(1.15); opacity: 0; }
  100% { transform: scale(1.15); opacity: 0; }
}

@keyframes near-pulse {
  0% { transform: scale(0.8); opacity: 0.5; }
  60% { transform: scale(1.06); opacity: 0.25; }
  100% { transform: scale(0.8); opacity: 0.5; }
}

/* 长辈模式：圈和点一起放大，别让大字配小点 */
.ui-mode-elder .me-dot { left: -12rpx; top: -12rpx; width: 24rpx; height: 24rpx; border-width: 4rpx; }
.ui-mode-elder .me-ring { left: -52rpx; top: -52rpx; width: 104rpx; height: 104rpx; }
.ui-mode-elder .near-ring { left: -76rpx; top: -132rpx; width: 152rpx; height: 152rpx; }
