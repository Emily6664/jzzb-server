# ==================== 基础 ====================
# 服务名（出现在 /docs 和健康检查里）
APP_NAME=乡语新叙 API
# 监听地址：0.0.0.0 = 所有网卡（配合反向代理 / 容器部署）
# 只想让本机代理转发，可以改成 127.0.0.1
HOST=0.0.0.0
# 唯一对外端口
PORT=8000
# 信任哪些来源的 X-Forwarded-*：* = 全部；代理和服务同机时建议改成 127.0.0.1
FORWARDED_ALLOW_IPS=*
# 接口前缀，必须和小程序 utils/api.js 的 BASE_URL 结尾一致（默认 .../api）
API_PREFIX=/api
# 反向代理把服务挂在子路径时填，例如 /xiangyu
ROOT_PATH=
LOG_LEVEL=INFO
# 时区：影响所有 "YYYY-MM-DD HH:mm:ss" 时间和订单号里的日期
TIMEZONE=Asia/Shanghai
# 生产环境建议改 false，关掉 /docs、/redoc
DOCS_ENABLED=true
# 允许跨域的来源，逗号分隔；小程序本身不需要 CORS，留着方便浏览器调试
CORS_ORIGINS=*

# ==================== 存储 ====================
DATA_DIR=./data
# 留空 = {DATA_DIR}/app.db
DB_PATH=
# 启动时建表 + 补种子数据（幂等）
SEED_ON_STARTUP=true
# 是否插入三条演示订单
SEED_DEMO_DATA=true

# ==================== 登录态 ====================
# 小程序目前不会带 Authorization 头，所以默认 false：没有 token 时按演示用户处理。
# 等前端在 utils/api.js 里补上 token 注入后，改成 true 开启强校验。
AUTH_REQUIRED=false
# 未开启微信支付时，调 /goods/orders/{id}/pay 是否直接把订单标记为已支付
# （小程序在 payParams=null 时会自己判「支付成功」，这里保持同样语义）
MOCK_PAY_AUTO_CONFIRM=true
# 详情类查询没命中时：true = code 0 + data null（页面走空态，与 mock 一致）；
# false = 按 API_DOC 返回 40400
NOT_FOUND_AS_NULL=true
TOKEN_TTL_SECONDS=2592000
DEMO_USER_ID=user-0001
DEMO_USER_PHONE=13800138000
DEMO_USER_NICKNAME=围山访客

# ==================== 静态资源 ====================
# 种子数据里的占位前缀（一般不用改）
MEDIA_SOURCE_BASE=https://cdn.example.com/xiangyu-xinxu
# 把占位域名换成真实地址：所有响应里的图片 / 音频地址会自动替换；留空 = 原样返回。
# 不用 CDN 就填 https://你的域名/media，文件放进 MEDIA_DIR，服务会把 /media/* 映射过去。
MEDIA_BASE_URL=
# 媒体文件根目录（相对路径以 server/ 为基准），启动时自动创建并挂到 /media
MEDIA_DIR=./media

# ==================== 微信小程序（不配就走进演示登录） ====================
WECHAT_APPID=
WECHAT_SECRET=

# ==================== 微信支付 v3（默认关闭，个人主体小程序用不上） ====================
# 开启前先装可选依赖：uv sync --extra pay
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
# 必须是公网可访问的 https 地址，例如 https://api.example.com/api/notify/wechat-pay
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_DESCRIPTION_PREFIX=乡语新叙文创

# ==================== AI 生图（可选） ====================
# 留空 IMAGE_API_KEY 时走「本地合成」：用 media/material/1..4.jpg 当版式底纹，
# Pillow 把拼贴成图装进 1080x1440 的海报里，离线、免费、不需要任何密钥。
# 配了 IMAGE_API_KEY 才会调外部图生图服务（OpenAI 兼容协议），失败会自动回落本地合成。
IMAGE_API_BASE=https://aiapi.shiwuyan.cn/v1
IMAGE_API_KEY=
# 以 gpt-image- 开头走 /images/edits，否则走 /chat/completions
IMAGE_MODEL=gpt-image-2
IMAGE_TIMEOUT_SECONDS=100
